# Copy this file to `.env` and fill in the values you need.
# Every value is optional: the app runs with the defaults below.

# DeepSeek / OpenAI-compatible endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash

# ---- Alternative: DeepSeek V4.1 Flash via NVIDIA NIM (free tier) ----
# Get a key at https://build.nvidia.com then uncomment these three lines:
# DEEPSEEK_API_KEY=nvapi-...
# DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
# DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash

# Facebook extraction behaviour
FACEBOOK_DELAY_SECONDS=2
ENABLE_PLAYWRIGHT=false
PLAYWRIGHT_HEADLESS=true
COOKIE_FILE=cookies.txt

# Local transcription (requires the optional faster-whisper dependency)
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto

# AI summarisation
MAX_TRANSCRIPT_CHARS=20000
AUTO_SUMMARIZE=false

# Storage
DATABASE_PATH=data/facebook_content.db

# Network robustness (optional overrides)
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF=2
